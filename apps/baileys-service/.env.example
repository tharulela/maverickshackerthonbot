PORT=3000
SESSION_API_URL=http://localhost:4000
OPENAI_API_KEY=your_openai_key
LOG_LEVEL=info

# Existing onboarding/profile backends
IKHOKHA_BASE_URL=http://localhost:8080
PROFILE_BASE_URL=http://localhost:8080
RELY_COMPLY_BASE_URL=http://localhost:8080
HSPROXY_BASE_URL=http://localhost:8080
MCC_CLASSIFIER_URL=http://localhost:8080/api/classify-business-industry

# Optional shared backend auth
BACKEND_AUTH_HEADER=Authorization
BACKEND_AUTH_TOKEN=

# Webhook and flow controls
WHATSAPP_WEBHOOK_SECRET=
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX_REQUESTS=30
REQUEST_TIMEOUT_MS=15000
OCR_RETRY_LIMIT=2
IS_AI_POWERED_MCC_ENABLED=false

# Selfie handoff link generation
SELFIE_BASE_URL=https://selfie.example.com/capture
SELFIE_LINK_SECRET=replace-with-strong-32-char-min-secret
SELFIE_LINK_TTL_SECONDS=900
